{
  "name": "founder-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop start",
    "desktop:package": "npm --prefix desktop run package:portable",
    "desktop:setup": "npm --prefix desktop run package:win",
    "desktop:sync": "powershell -Command \"New-Item -ItemType Directory -Force -Path 'public/downloads'; Copy-Item -Path 'desktop/release/FounderOS Setup 1.0.0.exe' -Destination 'public/downloads/FounderOS-Setup.exe' -Force\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
